# Server-only: explicit development adapter. Never allowed in production.
STORAGE_ADAPTER=json
LOCAL_STORE_PATH=.local/plans.json
# For Firestore Emulator: set STORAGE_ADAPTER=firestore and uncomment:
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
GOOGLE_CLOUD_PROJECT=demo-food-access
# Production uses the attached service account; do not download keys.
# Public build-time basemap style. Omit to use OpenFreeMap Positron.
NEXT_PUBLIC_MAP_STYLE=https://tiles.openfreemap.org/styles/positron
